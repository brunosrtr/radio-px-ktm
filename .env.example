# Postgres
POSTGRES_USER=radiopx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=radiopx
POSTGRES_PORT=5432

# Backend (também usadas por `go run ./cmd/seed`)
BACKEND_PORT=8080
DATABASE_URL=postgres://radiopx:changeme@postgres:5432/radiopx?sslmode=disable
# Trocar por um valor forte e único fora de ambiente local — assina o JWT de
# sessão (usuario_id, empresa_id, papel) e nunca deve ser versionado de verdade.
JWT_SECRET=changeme

# Rede Orbit. PONTO_ID_SEGREDO assina o código anônimo (renovado a cada 24 h)
# que identifica cada ponto de transmissão nas leituras; sem ele, é derivado
# do JWT_SECRET. KTM_INTEGRACAO_URL, se definida, recebe as leituras por POST.
# PONTO_ID_SEGREDO=changeme
# KTM_INTEGRACAO_URL=

# E-mail da recuperação de senha. Sem SMTP_HOST, o docker compose usa o
# Mailpit local (http://localhost:8025). Fora do compose, deixe vazio para
# desativar a recuperação (responde 503) ou aponte para um SMTP real.
# SMTP_HOST=mailpit
# SMTP_PORTA=1025
# SMTP_USUARIO=
# SMTP_SENHA=
# SMTP_REMETENTE=nao-responda@radiopx.local

# Descoberta local (o docker-compose.lan.yml já habilita estas opções)
# LOCAL_DISCOVERY=true
# LOCAL_ID_FILE=.radio-px-server-id

# App Flutter: sem --dart-define, descobre o computador na rede local.
# API_BASE_URL e WS_BASE_URL continuam disponíveis como --dart-define
# para desenvolvimento via USB ou acesso explícito a outro servidor.
