# Postgres
POSTGRES_USER=radiopx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=radiopx
POSTGRES_PORT=5432

# Backend (também usadas por `go run ./cmd/seed`)
BACKEND_PORT=8080
DATABASE_URL=postgres://radiopx:changeme@postgres:5432/radiopx?sslmode=disable
# Trocar por um valor forte e único fora de ambiente local — assina o JWT de
# sessão (usuario_id, empresa_id, papel) e nunca deve ser versionado de verdade.
JWT_SECRET=changeme

# App (Flutter) — não lidas de .env; passadas em tempo de build via
# --dart-define, ex.: `flutter run --dart-define=API_BASE_URL=http://localhost:8080
# --dart-define=WS_BASE_URL=ws://localhost:8080`. Documentadas aqui só como
# referência dos valores padrão já embutidos em app/lib/core/env.dart.
# API_BASE_URL=http://localhost:8080
# WS_BASE_URL=ws://localhost:8080
