# Postgres
POSTGRES_USER=radiopx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=radiopx
POSTGRES_PORT=5432

# Backend (também usadas por `go run ./cmd/seed`)
BACKEND_PORT=8080
DATABASE_URL=postgres://radiopx:changeme@postgres:5432/radiopx?sslmode=disable
# Trocar por um valor forte e único fora de ambiente local — assina o JWT de
# sessão (usuario_id, empresa_id, papel) e nunca deve ser versionado de verdade.
JWT_SECRET=changeme

# Descoberta local (o docker-compose.lan.yml já habilita estas opções)
# LOCAL_DISCOVERY=true
# LOCAL_ID_FILE=.radio-px-server-id

# App Flutter: sem --dart-define, descobre o computador na rede local.
# API_BASE_URL e WS_BASE_URL continuam disponíveis como --dart-define
# para desenvolvimento via USB ou acesso explícito a outro servidor.
